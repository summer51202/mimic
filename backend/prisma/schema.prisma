generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum GroupType {
  COUPLE
  GROUP
}

enum GroupStatus {
  ACTIVE
  ARCHIVED
}

enum MemberRole {
  OWNER
  MEMBER
}

enum MemberStatus {
  ACTIVE
  LEFT
  REMOVED
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum FundStatus {
  ACTIVE
  ARCHIVED
}

enum CategoryType {
  EXPENSE
}

enum CategoryStatus {
  ACTIVE
  ARCHIVED
}

enum RecordStatus {
  ACTIVE
  DELETED
}

enum ContributionType {
  REGULAR
  ONE_TIME
  ADJUSTMENT
  CORRECTION
}

enum ExpenseSplitMode {
  EQUAL
  RATIO
  FIXED
  HYBRID
}

enum ExpenseType {
  FUND_EXPENSE
  REFUND
  ADJUSTMENT
  CORRECTION
}

enum SplitType {
  EQUAL
  RATIO
  FIXED
}

enum SettlementStatus {
  PENDING
  COMPLETED
  CANCELED
}

enum SettlementType {
  SCHEDULED
  MANUAL
}

enum RecurringRuleStatus {
  ACTIVE
  PAUSED
  ENDED
}

enum AuditEntityType {
  GROUP
  FUND
  CATEGORY
  CONTRIBUTION
  EXPENSE
  SETTLEMENT
  RECURRING_RULE
  GROUP_MEMBER
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  COMPLETE
  CANCEL
  ARCHIVE
  UNARCHIVE
  ROLE_CHANGE
}

model User {
  sharedPayers SharedExpensePayer[]
  sharedAllocations SharedExpenseAllocation[]
  ownedTaxonomyTerms TaxonomyTerm[] @relation("TaxonomyOwner")
  createdTaxonomyTerms TaxonomyTerm[] @relation("TaxonomyCreator")
  taxonomyAuditEvents TaxonomyAuditEvent[] @relation("TaxonomyAuditActor")
  createdExpenseRecords ExpenseRecord[] @relation("ExpenseRecordCreator")
  updatedExpenseRecords ExpenseRecord[] @relation("ExpenseRecordUpdater")
  expenseMutationReceipts ExpenseMutationReceipt[] @relation("ExpenseReceiptActor")
  personalSpaces FinancialSpace[] @relation("PersonalSpaceOwner")
  createdSpaces FinancialSpace[] @relation("SpaceCreator")
  spaceParticipations SpaceParticipant[]
  spaceAuditEvents SpaceAuditEvent[] @relation("SpaceAuditActor")
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique @db.VarChar(255)
  passwordHash  String   @map("password_hash") @db.VarChar(255)
  displayName   String   @map("display_name") @db.VarChar(100)
  mimicId       String   @unique @map("mimic_id") @db.VarChar(15)
  avatarUrl     String?  @map("avatar_url") @db.VarChar(500)
  locale        String   @default("zh-TW") @db.VarChar(20)
  timezone      String   @default("Asia/Taipei") @db.VarChar(100)
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdGroups        Group[]                   @relation("GroupCreatedBy")
  memberships          GroupMember[]
  sentInvites          GroupInvite[]             @relation("InviteCreatedBy")
  acceptedInvites      GroupInvite[]             @relation("InviteAcceptedBy")
  createdFunds         Fund[]                    @relation("FundCreatedBy")
  contributions        Contribution[]            @relation("ContributionUser")
  createdContributions Contribution[]            @relation("ContributionCreatedBy")
  updatedContributions Contribution[]            @relation("ContributionUpdatedBy")
  deletedContributions Contribution[]            @relation("ContributionDeletedBy")
  createdExpenses      Expense[]                 @relation("ExpenseCreatedBy")
  updatedExpenses      Expense[]                 @relation("ExpenseUpdatedBy")
  deletedExpenses      Expense[]                 @relation("ExpenseDeletedBy")
  expensePayers        ExpensePayer[]
  expenseSplits        ExpenseSplit[]
  settlementsFrom      Settlement[]              @relation("SettlementFromUser")
  settlementsTo        Settlement[]              @relation("SettlementToUser")
  settlementsCreated   Settlement[]              @relation("SettlementCreatedBy")
  recurringRuleUsers   RecurringContributionRule[] @relation("RecurringRuleUser")
  recurringRuleCreated RecurringContributionRule[] @relation("RecurringRuleCreatedBy")
  auditLogs            AuditLog[]                @relation("AuditActor")
}

model Group {
  taxonomyTerms TaxonomyTerm[]
  financialSpaces FinancialSpace[]
  id              String      @id @default(uuid()) @db.Uuid
  name            String      @db.VarChar(100)
  groupType       GroupType   @map("group_type")
  defaultCurrency String      @map("default_currency") @db.VarChar(3)
  status          GroupStatus @default(ACTIVE)
  createdById     String      @map("created_by") @db.Uuid
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdBy       User        @relation("GroupCreatedBy", fields: [createdById], references: [id])
  members         GroupMember[]
  invites         GroupInvite[]
  funds           Fund[]
  categories      Category[]
  auditLogs       AuditLog[]

  @@map("groups")
  @@index([createdById])
}

model GroupMember {
  id         String       @id @default(uuid()) @db.Uuid
  groupId    String       @map("group_id") @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  role       MemberRole
  status     MemberStatus @default(ACTIVE)
  joinedAt   DateTime     @default(now()) @map("joined_at") @db.Timestamptz(6)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  group      Group        @relation(fields: [groupId], references: [id])
  user       User         @relation(fields: [userId], references: [id])

  @@map("group_members")
  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
  @@index([groupId, role, status])
}

model GroupInvite {
  id           String       @id @default(uuid()) @db.Uuid
  groupId      String       @map("group_id") @db.Uuid
  inviteCode   String       @unique @map("invite_code") @db.VarChar(64)
  invitedById  String       @map("invited_by") @db.Uuid
  invitedEmail String?      @map("invited_email") @db.VarChar(255)
  expiresAt    DateTime     @map("expires_at") @db.Timestamptz(6)
  status       InviteStatus @default(PENDING)
  acceptedById String?      @map("accepted_by") @db.Uuid
  acceptedAt   DateTime?    @map("accepted_at") @db.Timestamptz(6)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  group        Group        @relation(fields: [groupId], references: [id])
  invitedBy    User         @relation("InviteCreatedBy", fields: [invitedById], references: [id])
  acceptedBy   User?        @relation("InviteAcceptedBy", fields: [acceptedById], references: [id])

  @@map("group_invites")
  @@index([groupId, status])
}

model Fund {
  id           String     @id @default(uuid()) @db.Uuid
  groupId      String     @map("group_id") @db.Uuid
  name         String     @db.VarChar(100)
  currency     String     @db.VarChar(3)
  status       FundStatus @default(ACTIVE)
  archivedAt   DateTime?  @map("archived_at") @db.Timestamptz(6)
  createdById  String     @map("created_by") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  group        Group      @relation(fields: [groupId], references: [id])
  createdBy    User       @relation("FundCreatedBy", fields: [createdById], references: [id])
  contributions Contribution[]
  expenses     Expense[]
  settlements  Settlement[]
  recurringRules RecurringContributionRule[]
  auditLogs    AuditLog[]

  @@map("funds")
  @@index([groupId, status])
}

model Category {
  id         String         @id @default(uuid()) @db.Uuid
  groupId    String?        @map("group_id") @db.Uuid
  name       String         @db.VarChar(100)
  type       CategoryType   @default(EXPENSE)
  sortOrder  Int            @default(0) @map("sort_order")
  isDefault  Boolean        @default(false) @map("is_default")
  status     CategoryStatus @default(ACTIVE)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  group      Group?         @relation(fields: [groupId], references: [id])
  expenses   Expense[]

  @@map("categories")
  @@index([groupId, status, sortOrder])
}

model Contribution {
  id                String           @id @default(uuid()) @db.Uuid
  fundId            String           @map("fund_id") @db.Uuid
  contributorUserId String           @map("contributor_user_id") @db.Uuid
  amountMinor       BigInt           @map("amount_minor")
  contributionType  ContributionType @map("contribution_type")
  note              String?          @db.Text
  occurredOn        DateTime         @map("occurred_on") @db.Date
  status            RecordStatus     @default(ACTIVE)
  createdById       String           @map("created_by") @db.Uuid
  updatedById       String           @map("updated_by") @db.Uuid
  deletedById       String?          @map("deleted_by") @db.Uuid
  deletedAt         DateTime?        @map("deleted_at") @db.Timestamptz(6)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  fund              Fund             @relation(fields: [fundId], references: [id])
  contributor       User             @relation("ContributionUser", fields: [contributorUserId], references: [id])
  createdBy         User             @relation("ContributionCreatedBy", fields: [createdById], references: [id])
  updatedBy         User             @relation("ContributionUpdatedBy", fields: [updatedById], references: [id])
  deletedBy         User?            @relation("ContributionDeletedBy", fields: [deletedById], references: [id])

  @@map("contributions")
  @@index([fundId, occurredOn, status])
  @@index([contributorUserId, status])
}

model Expense {
  id           String           @id @default(uuid()) @db.Uuid
  fundId       String           @map("fund_id") @db.Uuid
  categoryId   String?          @map("category_id") @db.Uuid
  title        String           @db.VarChar(200)
  note         String?          @db.Text
  amountMinor  BigInt           @map("amount_minor")
  splitMode    ExpenseSplitMode @map("split_mode")
  expenseType  ExpenseType      @map("expense_type")
  occurredOn   DateTime         @map("occurred_on") @db.Date
  status       RecordStatus     @default(ACTIVE)
  createdById  String           @map("created_by") @db.Uuid
  updatedById  String           @map("updated_by") @db.Uuid
  deletedById  String?          @map("deleted_by") @db.Uuid
  deletedAt    DateTime?        @map("deleted_at") @db.Timestamptz(6)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  fund         Fund             @relation(fields: [fundId], references: [id])
  category     Category?        @relation(fields: [categoryId], references: [id])
  createdBy    User             @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  updatedBy    User             @relation("ExpenseUpdatedBy", fields: [updatedById], references: [id])
  deletedBy    User?            @relation("ExpenseDeletedBy", fields: [deletedById], references: [id])
  payers       ExpensePayer[]
  splits       ExpenseSplit[]

  @@map("expenses")
  @@index([fundId, occurredOn, status])
  @@index([categoryId])
  @@index([expenseType, status])
}

model ExpensePayer {
  id          String   @id @default(uuid()) @db.Uuid
  expenseId   String   @map("expense_id") @db.Uuid
  payerUserId String   @map("payer_user_id") @db.Uuid
  amountMinor BigInt   @map("amount_minor")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  expense     Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  payer       User     @relation(fields: [payerUserId], references: [id])

  @@map("expense_payers")
  @@index([expenseId])
  @@index([payerUserId])
}

model ExpenseSplit {
  id                   String    @id @default(uuid()) @db.Uuid
  expenseId            String    @map("expense_id") @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  splitType            SplitType @map("split_type")
  ratioValue           Decimal?  @map("ratio_value") @db.Decimal(10, 6)
  fixedAmountMinor     BigInt?   @map("fixed_amount_minor")
  allocatedAmountMinor BigInt    @map("allocated_amount_minor")
  sortOrder            Int       @default(0) @map("sort_order")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  expense              Expense   @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user                 User      @relation(fields: [userId], references: [id])

  @@map("expense_splits")
  @@index([expenseId, sortOrder])
  @@index([userId])
}

model Settlement {
  id             String           @id @default(uuid()) @db.Uuid
  fundId         String           @map("fund_id") @db.Uuid
  fromUserId     String           @map("from_user_id") @db.Uuid
  toUserId       String           @map("to_user_id") @db.Uuid
  amountMinor    BigInt           @map("amount_minor")
  periodStart    DateTime?        @map("period_start") @db.Date
  periodEnd      DateTime?        @map("period_end") @db.Date
  status         SettlementStatus @default(PENDING)
  settlementType SettlementType   @map("settlement_type")
  note           String?          @db.Text
  completedAt    DateTime?        @map("completed_at") @db.Timestamptz(6)
  canceledAt     DateTime?        @map("canceled_at") @db.Timestamptz(6)
  createdById    String           @map("created_by") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  fund           Fund             @relation(fields: [fundId], references: [id])
  fromUser       User             @relation("SettlementFromUser", fields: [fromUserId], references: [id])
  toUser         User             @relation("SettlementToUser", fields: [toUserId], references: [id])
  createdBy      User             @relation("SettlementCreatedBy", fields: [createdById], references: [id])

  @@map("settlements")
  @@index([fundId, status])
  @@index([fundId, periodStart, periodEnd])
  @@index([fromUserId, status])
  @@index([toUserId, status])
}

model RecurringContributionRule {
  id             String              @id @default(uuid()) @db.Uuid
  fundId         String              @map("fund_id") @db.Uuid
  userId         String              @map("user_id") @db.Uuid
  amountMinor    BigInt              @map("amount_minor")
  frequency      String              @db.VarChar(20)
  dayOfMonth     Int                 @map("day_of_month")
  startDate      DateTime            @map("start_date") @db.Date
  endDate        DateTime?           @map("end_date") @db.Date
  status         RecurringRuleStatus @default(ACTIVE)
  lastPromptedAt DateTime?           @map("last_prompted_at") @db.Timestamptz(6)
  createdById    String              @map("created_by") @db.Uuid
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  fund           Fund                @relation(fields: [fundId], references: [id])
  user           User                @relation("RecurringRuleUser", fields: [userId], references: [id])
  createdBy      User                @relation("RecurringRuleCreatedBy", fields: [createdById], references: [id])

  @@map("recurring_contribution_rules")
  @@index([fundId, status])
  @@index([userId, status])
}

model AuditLog {
  id             String          @id @default(uuid()) @db.Uuid
  groupId        String?         @map("group_id") @db.Uuid
  fundId         String?         @map("fund_id") @db.Uuid
  actorUserId    String          @map("actor_user_id") @db.Uuid
  entityType     AuditEntityType @map("entity_type")
  entityId       String          @map("entity_id") @db.Uuid
  action         AuditAction
  beforeSnapshot Json?           @map("before_snapshot")
  afterSnapshot  Json?           @map("after_snapshot")
  metadata       Json?
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  group          Group?          @relation(fields: [groupId], references: [id])
  fund           Fund?           @relation(fields: [fundId], references: [id])
  actor          User            @relation("AuditActor", fields: [actorUserId], references: [id])

  @@map("audit_logs")
  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
  @@index([groupId, createdAt])
  @@index([fundId, createdAt])
}

enum FinancialSpaceMode {
  PERSONAL_EXPENSES
  SHARED_EXPENSES
  POOLED_FUND
}

enum FinancialSpaceStatus {
  ACTIVE
  ARCHIVED
}

enum SpaceParticipantRole {
  MANAGER
  PARTICIPANT
}

enum SpaceAuditAction {
  EXPENSE_CREATED
  EXPENSE_UPDATED
  EXPENSE_DELETED
  CREATE
  UPDATE
  PARTICIPANT_ADDED
  PARTICIPANT_ENDED
  ROLE_CHANGED
  ARCHIVE
}

model FinancialSpace {
  expenseRecords ExpenseRecord[]
  expenseReceipts ExpenseMutationReceipt[]
  id                  String               @id @default(uuid()) @db.Uuid
  name                String               @db.VarChar(100)
  mode                FinancialSpaceMode
  currency            String               @db.VarChar(3)
  timezone            String               @default("Asia/Taipei") @db.VarChar(100)
  openedOn            DateTime             @map("opened_on") @db.Date
  groupId             String?              @map("group_id") @db.Uuid
  ownerUserId         String?              @map("owner_user_id") @db.Uuid
  createdById         String               @map("created_by_id") @db.Uuid
  status              FinancialSpaceStatus @default(ACTIVE)
  firstFormalRecordAt DateTime?            @map("first_formal_record_at") @db.Timestamptz(6)
  archivedAt          DateTime?            @map("archived_at") @db.Timestamptz(6)
  version             Int                  @default(1)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  group               Group?               @relation(fields: [groupId], references: [id])
  owner               User?                @relation("PersonalSpaceOwner", fields: [ownerUserId], references: [id])
  creator             User                 @relation("SpaceCreator", fields: [createdById], references: [id])
  participants        SpaceParticipant[]
  auditEvents         SpaceAuditEvent[]

  @@index([groupId, status])
  @@index([ownerUserId, status])
  @@map("financial_spaces")
}

model SpaceParticipant {
  id            String               @id @default(uuid()) @db.Uuid
  spaceId       String               @map("space_id") @db.Uuid
  userId        String               @map("user_id") @db.Uuid
  role          SpaceParticipantRole @default(PARTICIPANT)
  effectiveFrom DateTime             @map("effective_from") @db.Date
  effectiveTo   DateTime?            @map("effective_to") @db.Date
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  space         FinancialSpace       @relation(fields: [spaceId], references: [id])
  user          User                 @relation(fields: [userId], references: [id])

  @@index([spaceId, userId, effectiveFrom])
  @@index([userId, effectiveTo])
  @@map("space_participants")
}

model SpaceAuditEvent {
  id          String           @id @default(uuid()) @db.Uuid
  spaceId     String           @map("space_id") @db.Uuid
  actorUserId String           @map("actor_user_id") @db.Uuid
  action      SpaceAuditAction
  before      Json?
  after       Json
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  space       FinancialSpace   @relation(fields: [spaceId], references: [id])
  actor       User             @relation("SpaceAuditActor", fields: [actorUserId], references: [id])

  @@index([spaceId, createdAt])
  @@map("space_audit_events")
}

enum TaxonomyKind {
  CATEGORY
  TAG
}
enum TaxonomyScope {
  SYSTEM
  PERSONAL
  GROUP
}
enum TaxonomyStatus {
  ACTIVE
  ARCHIVED
  MERGED
}
enum TaxonomyAction {
  CREATE
  RENAME
  MERGE
  ARCHIVE
}
enum ExpenseMutationAction {
  CREATE
  UPDATE
  DELETE
}

model TaxonomyTerm {
  id             String @id @default(uuid()) @db.Uuid
  kind           TaxonomyKind
  scope          TaxonomyScope
  scopeKey       String @map("scope_key") @db.VarChar(64)
  ownerUserId    String? @map("owner_user_id") @db.Uuid
  groupId        String? @map("group_id") @db.Uuid
  systemKey      String? @unique @map("system_key") @db.VarChar(64)
  name           String @db.VarChar(60)
  normalizedName String @map("normalized_name") @db.VarChar(120)
  translations   Json @default("{}")
  categoryKeys   String[] @default([]) @map("category_keys")
  status         TaxonomyStatus @default(ACTIVE)
  mergedIntoId   String? @map("merged_into_id") @db.Uuid
  createdById    String? @map("created_by_id") @db.Uuid
  version        Int @default(1)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  owner          User? @relation("TaxonomyOwner", fields: [ownerUserId], references: [id])
  group          Group? @relation(fields: [groupId], references: [id])
  creator        User? @relation("TaxonomyCreator", fields: [createdById], references: [id])
  mergedInto     TaxonomyTerm? @relation("TaxonomyMerge", fields: [mergedIntoId], references: [id])
  mergedSources  TaxonomyTerm[] @relation("TaxonomyMerge")
  expenseRecords ExpenseRecord[] @relation("ExpenseCategory")
  expenseTags    ExpenseRecordTag[]
  auditEvents    TaxonomyAuditEvent[]
  @@index([scopeKey, kind, status])
  @@map("taxonomy_terms")
}
model TaxonomyAuditEvent {
  id          String @id @default(uuid()) @db.Uuid
  termId      String @map("term_id") @db.Uuid
  actorUserId String @map("actor_user_id") @db.Uuid
  action      TaxonomyAction
  before      Json?
  after       Json
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  term        TaxonomyTerm @relation(fields: [termId], references: [id])
  actor       User @relation("TaxonomyAuditActor", fields: [actorUserId], references: [id])
  @@index([termId, createdAt])
  @@map("taxonomy_audit_events")
}
model ExpenseRecord {
  sharedPayers SharedExpensePayer[]
  sharedAllocations SharedExpenseAllocation[]
  id          String @id @default(uuid()) @db.Uuid
  spaceId     String @map("space_id") @db.Uuid
  amountMinor BigInt @map("amount_minor")
  occurredOn  DateTime @map("occurred_on") @db.Date
  title       String @db.VarChar(200)
  note        String? @db.VarChar(2000)
  categoryId  String @map("category_id") @db.Uuid
  status      RecordStatus @default(ACTIVE)
  version     Int @default(1)
  createdById String @map("created_by_id") @db.Uuid
  updatedById String @map("updated_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  space       FinancialSpace @relation(fields: [spaceId], references: [id])
  category    TaxonomyTerm @relation("ExpenseCategory", fields: [categoryId], references: [id])
  creator     User @relation("ExpenseRecordCreator", fields: [createdById], references: [id])
  updater     User @relation("ExpenseRecordUpdater", fields: [updatedById], references: [id])
  tags        ExpenseRecordTag[]
  @@index([spaceId, status, occurredOn, id])
  @@map("expense_records")
}
model ExpenseRecordTag {
  expenseId String @map("expense_id") @db.Uuid
  tagId     String @map("tag_id") @db.Uuid
  expense   ExpenseRecord @relation(fields: [expenseId], references: [id])
  tag       TaxonomyTerm @relation(fields: [tagId], references: [id])
  @@id([expenseId, tagId])
  @@map("expense_record_tags")
}

model SharedExpensePayer {
  expenseId String @map("expense_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  amountMinor BigInt @map("amount_minor")
  expense ExpenseRecord @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])
  @@id([expenseId, userId])
  @@index([userId])
  @@map("shared_expense_payers")
}
model SharedExpenseAllocation {
  expenseId String @map("expense_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  amountMinor BigInt @map("amount_minor")
  expense ExpenseRecord @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])
  @@id([expenseId, userId])
  @@index([userId])
  @@map("shared_expense_allocations")
}
model ExpenseMutationReceipt {
  id          String @id @default(uuid()) @db.Uuid
  spaceId     String @map("space_id") @db.Uuid
  actorUserId String @map("actor_user_id") @db.Uuid
  requestId   String @map("request_id") @db.Uuid
  action      ExpenseMutationAction
  payloadHash String @map("payload_hash") @db.VarChar(64)
  response    Json
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  space       FinancialSpace @relation(fields: [spaceId], references: [id])
  actor       User @relation("ExpenseReceiptActor", fields: [actorUserId], references: [id])
  @@unique([spaceId, actorUserId, requestId])
  @@map("expense_mutation_receipts")
}
