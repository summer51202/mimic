generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum GroupType {
  COUPLE
  GROUP
}

enum GroupStatus {
  ACTIVE
  ARCHIVED
}

enum MemberRole {
  OWNER
  MEMBER
}

enum MemberStatus {
  ACTIVE
  LEFT
  REMOVED
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum RecordStatus {
  ACTIVE
  DELETED
}

enum AuditEntityType {
  GROUP
  GROUP_MEMBER
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  COMPLETE
  CANCEL
  ARCHIVE
  UNARCHIVE
  ROLE_CHANGE
}

model User {
  pooledCommitmentsCreated     PooledCommitment[]             @relation("PooledCommitmentCreator")
  pooledAssignments            PooledCommitmentAssignment[]
  pooledOccurrences            PooledContributionOccurrence[] @relation("PooledOccurrenceParticipant")
  pooledOccurrencesConfirmed   PooledContributionOccurrence[] @relation("PooledOccurrenceConfirmer")
  pooledOccurrencesSkipped     PooledContributionOccurrence[] @relation("PooledOccurrenceSkipper")
  pooledOccurrencesCanceled    PooledContributionOccurrence[] @relation("PooledOccurrenceCanceler")
  pooledContributions          PooledContribution[]           @relation("PooledContributionParticipant")
  pooledContributionsConfirmed PooledContribution[]           @relation("PooledContributionConfirmer")
  pooledExpenseAdvances        PooledExpensePayment[]         @relation("PooledExpenseAdvancer")
  pooledReimbursements         PooledReimbursement[]          @relation("PooledReimbursementParticipant")
  pooledReimbursementsSent     PooledReimbursement[]          @relation("PooledReimbursementSender")
  pooledReimbursementsReceived PooledReimbursement[]          @relation("PooledReimbursementReceiver")
  pooledCorrections            PooledCorrection[]             @relation("PooledCorrectionCreator")
  pooledReturnPlansCreated     PooledReturnPlan[]             @relation("PooledReturnPlanCreator")
  pooledReturns                PooledReturn[]                 @relation("PooledReturnRecipient")
  pooledReturnsSent            PooledReturn[]                 @relation("PooledReturnSender")
  pooledReturnsReceived        PooledReturn[]                 @relation("PooledReturnReceiver")
  pooledTransitionPostings     PooledTransitionPosting[]      @relation("PooledPostingActor")
  pooledOperationReceipts      PooledOperationReceipt[]
  sharedBatchesCreated         SharedSettlementBatch[]        @relation("SharedBatchCreator")
  sharedBatchesCompleted       SharedSettlementBatch[]        @relation("SharedBatchCompleter")
  sharedBatchesCanceled        SharedSettlementBatch[]        @relation("SharedBatchCanceler")
  sharedTransfersFrom          SharedSettlementTransfer[]     @relation("SharedTransferFrom")
  sharedTransfersTo            SharedSettlementTransfer[]     @relation("SharedTransferTo")
  sharedTransfersSent          SharedSettlementTransfer[]     @relation("SharedTransferSender")
  sharedTransfersReceived      SharedSettlementTransfer[]     @relation("SharedTransferReceiver")
  sharedCorrections            SharedCorrection[]             @relation("SharedCorrectionCreator")
  sharedCorrectionPayers       SharedCorrectionPayer[]
  sharedCorrectionAllocations  SharedCorrectionAllocation[]
  sharedOperationReceipts      SharedOperationReceipt[]
  sharedPayers                 SharedExpensePayer[]
  sharedAllocations            SharedExpenseAllocation[]
  ownedTaxonomyTerms           TaxonomyTerm[]                 @relation("TaxonomyOwner")
  createdTaxonomyTerms         TaxonomyTerm[]                 @relation("TaxonomyCreator")
  taxonomyAuditEvents          TaxonomyAuditEvent[]           @relation("TaxonomyAuditActor")
  createdExpenseRecords        ExpenseRecord[]                @relation("ExpenseRecordCreator")
  updatedExpenseRecords        ExpenseRecord[]                @relation("ExpenseRecordUpdater")
  expenseMutationReceipts      ExpenseMutationReceipt[]       @relation("ExpenseReceiptActor")
  personalExpenseReferences    PersonalExpenseReference[]     @relation("PersonalReferenceOwner")
  personalReferenceReceipts    PersonalReferenceReceipt[]     @relation("PersonalReferenceReceiptActor")
  personalSpaces               FinancialSpace[]               @relation("PersonalSpaceOwner")
  createdSpaces                FinancialSpace[]               @relation("SpaceCreator")
  spaceParticipations          SpaceParticipant[]
  spaceAuditEvents             SpaceAuditEvent[]              @relation("SpaceAuditActor")
  id                           String                         @id @default(uuid()) @db.Uuid
  email                        String                         @unique @db.VarChar(255)
  passwordHash                 String                         @map("password_hash") @db.VarChar(255)
  displayName                  String                         @map("display_name") @db.VarChar(100)
  mimicId                      String                         @unique @map("mimic_id") @db.VarChar(15)
  avatarUrl                    String?                        @map("avatar_url") @db.VarChar(500)
  locale                       String                         @default("zh-TW") @db.VarChar(20)
  timezone                     String                         @default("Asia/Taipei") @db.VarChar(100)
  status                       UserStatus                     @default(ACTIVE)
  createdAt                    DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                    DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdGroups   Group[]       @relation("GroupCreatedBy")
  memberships     GroupMember[]
  sentInvites     GroupInvite[] @relation("InviteCreatedBy")
  acceptedInvites GroupInvite[] @relation("InviteAcceptedBy")
  auditLogs       AuditLog[]    @relation("AuditActor")
}

model Group {
  taxonomyTerms   TaxonomyTerm[]
  financialSpaces FinancialSpace[]
  id              String           @id @default(uuid()) @db.Uuid
  name            String           @db.VarChar(100)
  groupType       GroupType        @map("group_type")
  defaultCurrency String           @map("default_currency") @db.VarChar(3)
  status          GroupStatus      @default(ACTIVE)
  createdById     String           @map("created_by") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdBy User          @relation("GroupCreatedBy", fields: [createdById], references: [id])
  members   GroupMember[]
  invites   GroupInvite[]
  auditLogs AuditLog[]

  @@index([createdById])
  @@map("groups")
}

model GroupMember {
  id        String       @id @default(uuid()) @db.Uuid
  groupId   String       @map("group_id") @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  role      MemberRole
  status    MemberStatus @default(ACTIVE)
  joinedAt  DateTime     @default(now()) @map("joined_at") @db.Timestamptz(6)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  group Group @relation(fields: [groupId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
  @@index([groupId, role, status])
  @@map("group_members")
}

model GroupInvite {
  id           String       @id @default(uuid()) @db.Uuid
  groupId      String       @map("group_id") @db.Uuid
  inviteCode   String       @unique @map("invite_code") @db.VarChar(64)
  invitedById  String       @map("invited_by") @db.Uuid
  invitedEmail String?      @map("invited_email") @db.VarChar(255)
  expiresAt    DateTime     @map("expires_at") @db.Timestamptz(6)
  status       InviteStatus @default(PENDING)
  acceptedById String?      @map("accepted_by") @db.Uuid
  acceptedAt   DateTime?    @map("accepted_at") @db.Timestamptz(6)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  group      Group @relation(fields: [groupId], references: [id])
  invitedBy  User  @relation("InviteCreatedBy", fields: [invitedById], references: [id])
  acceptedBy User? @relation("InviteAcceptedBy", fields: [acceptedById], references: [id])

  @@index([groupId, status])
  @@map("group_invites")
}

model AuditLog {
  id             String          @id @default(uuid()) @db.Uuid
  groupId        String?         @map("group_id") @db.Uuid
  actorUserId    String          @map("actor_user_id") @db.Uuid
  entityType     AuditEntityType @map("entity_type")
  entityId       String          @map("entity_id") @db.Uuid
  action         AuditAction
  beforeSnapshot Json?           @map("before_snapshot")
  afterSnapshot  Json?           @map("after_snapshot")
  metadata       Json?
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  group Group? @relation(fields: [groupId], references: [id])
  actor User   @relation("AuditActor", fields: [actorUserId], references: [id])

  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
  @@index([groupId, createdAt])
  @@map("audit_logs")
}

enum FinancialSpaceMode {
  PERSONAL_EXPENSES
  SHARED_EXPENSES
  POOLED_FUND
}

enum FinancialSpaceStatus {
  ACTIVE
  CLOSING
  ARCHIVED
}

enum SpaceParticipantRole {
  MANAGER
  PARTICIPANT
}

enum SpaceAuditAction {
  POOLED_COMMITMENT_CREATED
  POOLED_COMMITMENT_UPDATED
  POOLED_OCCURRENCE_CONFIRMED
  POOLED_OCCURRENCE_SKIPPED
  POOLED_OCCURRENCE_CANCELED
  POOLED_REIMBURSEMENT_SENT
  POOLED_REIMBURSEMENT_RECEIVED
  POOLED_CORRECTION_CREATED
  POOLED_CLOSING_STARTED
  POOLED_RETURN_PLAN_CREATED
  POOLED_RETURN_SENT
  POOLED_RETURN_RECEIVED
  PERSONAL_REFERENCE_CREATED
  PERSONAL_REFERENCE_UPDATED
  PERSONAL_REFERENCE_REMOVED
  SHARED_BATCH_STARTED
  SHARED_BATCH_CANCELED
  SHARED_BATCH_COMPLETED
  SHARED_TRANSFER_SENT
  SHARED_TRANSFER_RECEIVED
  SHARED_CORRECTION_CREATED
  EXPENSE_CREATED
  EXPENSE_UPDATED
  EXPENSE_DELETED
  CREATE
  UPDATE
  PARTICIPANT_ADDED
  PARTICIPANT_ENDED
  ROLE_CHANGED
  ARCHIVE
}

model FinancialSpace {
  pooledCommitments         PooledCommitment[]
  pooledContributions       PooledContribution[]
  pooledReimbursements      PooledReimbursement[]
  pooledCorrections         PooledCorrection[]
  pooledReturnPlans         PooledReturnPlan[]
  pooledTransitionPostings  PooledTransitionPosting[]
  pooledOperationReceipts   PooledOperationReceipt[]
  personalReferences        PersonalExpenseReference[] @relation("PersonalReferenceSpace")
  personalReferenceReceipts PersonalReferenceReceipt[]
  sharedBatches             SharedSettlementBatch[]
  sharedCorrections         SharedCorrection[]
  sharedOperationReceipts   SharedOperationReceipt[]
  expenseRecords            ExpenseRecord[]
  expenseReceipts           ExpenseMutationReceipt[]
  id                        String                     @id @default(uuid()) @db.Uuid
  name                      String                     @db.VarChar(100)
  mode                      FinancialSpaceMode
  currency                  String                     @db.VarChar(3)
  timezone                  String                     @default("Asia/Taipei") @db.VarChar(100)
  openedOn                  DateTime                   @map("opened_on") @db.Date
  groupId                   String?                    @map("group_id") @db.Uuid
  ownerUserId               String?                    @map("owner_user_id") @db.Uuid
  createdById               String                     @map("created_by_id") @db.Uuid
  status                    FinancialSpaceStatus       @default(ACTIVE)
  firstFormalRecordAt       DateTime?                  @map("first_formal_record_at") @db.Timestamptz(6)
  archivedAt                DateTime?                  @map("archived_at") @db.Timestamptz(6)
  version                   Int                        @default(1)
  createdAt                 DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  group                     Group?                     @relation(fields: [groupId], references: [id])
  owner                     User?                      @relation("PersonalSpaceOwner", fields: [ownerUserId], references: [id])
  creator                   User                       @relation("SpaceCreator", fields: [createdById], references: [id])
  participants              SpaceParticipant[]
  auditEvents               SpaceAuditEvent[]

  @@index([groupId, status])
  @@index([ownerUserId, status])
  @@map("financial_spaces")
}

model SpaceParticipant {
  id            String               @id @default(uuid()) @db.Uuid
  spaceId       String               @map("space_id") @db.Uuid
  userId        String               @map("user_id") @db.Uuid
  role          SpaceParticipantRole @default(PARTICIPANT)
  effectiveFrom DateTime             @map("effective_from") @db.Date
  effectiveTo   DateTime?            @map("effective_to") @db.Date
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  space         FinancialSpace       @relation(fields: [spaceId], references: [id])
  user          User                 @relation(fields: [userId], references: [id])

  @@index([spaceId, userId, effectiveFrom])
  @@index([userId, effectiveTo])
  @@map("space_participants")
}

model SpaceAuditEvent {
  id          String           @id @default(uuid()) @db.Uuid
  spaceId     String           @map("space_id") @db.Uuid
  actorUserId String           @map("actor_user_id") @db.Uuid
  action      SpaceAuditAction
  before      Json?
  after       Json
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  space       FinancialSpace   @relation(fields: [spaceId], references: [id])
  actor       User             @relation("SpaceAuditActor", fields: [actorUserId], references: [id])

  @@index([spaceId, createdAt])
  @@map("space_audit_events")
}

enum TaxonomyKind {
  CATEGORY
  TAG
}

enum TaxonomyScope {
  SYSTEM
  PERSONAL
  GROUP
}

enum TaxonomyStatus {
  ACTIVE
  ARCHIVED
  MERGED
}

enum TaxonomyAction {
  CREATE
  RENAME
  MERGE
  ARCHIVE
}

enum ExpenseMutationAction {
  CREATE
  UPDATE
  DELETE
}

model TaxonomyTerm {
  id                    String                        @id @default(uuid()) @db.Uuid
  kind                  TaxonomyKind
  scope                 TaxonomyScope
  scopeKey              String                        @map("scope_key") @db.VarChar(64)
  ownerUserId           String?                       @map("owner_user_id") @db.Uuid
  groupId               String?                       @map("group_id") @db.Uuid
  systemKey             String?                       @unique @map("system_key") @db.VarChar(64)
  name                  String                        @db.VarChar(60)
  normalizedName        String                        @map("normalized_name") @db.VarChar(120)
  translations          Json                          @default("{}")
  categoryKeys          String[]                      @default([]) @map("category_keys")
  status                TaxonomyStatus                @default(ACTIVE)
  mergedIntoId          String?                       @map("merged_into_id") @db.Uuid
  createdById           String?                       @map("created_by_id") @db.Uuid
  version               Int                           @default(1)
  createdAt             DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(6)
  owner                 User?                         @relation("TaxonomyOwner", fields: [ownerUserId], references: [id])
  group                 Group?                        @relation(fields: [groupId], references: [id])
  creator               User?                         @relation("TaxonomyCreator", fields: [createdById], references: [id])
  mergedInto            TaxonomyTerm?                 @relation("TaxonomyMerge", fields: [mergedIntoId], references: [id])
  mergedSources         TaxonomyTerm[]                @relation("TaxonomyMerge")
  expenseRecords        ExpenseRecord[]               @relation("ExpenseCategory")
  expenseTags           ExpenseRecordTag[]
  personalReferenceTags PersonalExpenseReferenceTag[]
  auditEvents           TaxonomyAuditEvent[]

  @@index([scopeKey, kind, status])
  @@map("taxonomy_terms")
}

model TaxonomyAuditEvent {
  id          String         @id @default(uuid()) @db.Uuid
  termId      String         @map("term_id") @db.Uuid
  actorUserId String         @map("actor_user_id") @db.Uuid
  action      TaxonomyAction
  before      Json?
  after       Json
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  term        TaxonomyTerm   @relation(fields: [termId], references: [id])
  actor       User           @relation("TaxonomyAuditActor", fields: [actorUserId], references: [id])

  @@index([termId, createdAt])
  @@map("taxonomy_audit_events")
}

model ExpenseRecord {
  pooledPayment      PooledExpensePayment?
  personalReferences PersonalExpenseReference[]
  sharedCorrections  SharedCorrection[]
  sharedPayers       SharedExpensePayer[]
  sharedAllocations  SharedExpenseAllocation[]
  id                 String                     @id @default(uuid()) @db.Uuid
  spaceId            String                     @map("space_id") @db.Uuid
  amountMinor        BigInt                     @map("amount_minor")
  occurredOn         DateTime                   @map("occurred_on") @db.Date
  title              String                     @db.VarChar(200)
  note               String?                    @db.VarChar(2000)
  categoryId         String                     @map("category_id") @db.Uuid
  status             RecordStatus               @default(ACTIVE)
  version            Int                        @default(1)
  createdById        String                     @map("created_by_id") @db.Uuid
  updatedById        String                     @map("updated_by_id") @db.Uuid
  createdAt          DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  space              FinancialSpace             @relation(fields: [spaceId], references: [id])
  category           TaxonomyTerm               @relation("ExpenseCategory", fields: [categoryId], references: [id])
  creator            User                       @relation("ExpenseRecordCreator", fields: [createdById], references: [id])
  updater            User                       @relation("ExpenseRecordUpdater", fields: [updatedById], references: [id])
  tags               ExpenseRecordTag[]

  @@index([spaceId, status, occurredOn, id])
  @@map("expense_records")
}

model ExpenseRecordTag {
  expenseId String        @map("expense_id") @db.Uuid
  tagId     String        @map("tag_id") @db.Uuid
  expense   ExpenseRecord @relation(fields: [expenseId], references: [id])
  tag       TaxonomyTerm  @relation(fields: [tagId], references: [id])

  @@id([expenseId, tagId])
  @@map("expense_record_tags")
}

model SharedExpensePayer {
  expenseId   String        @map("expense_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  amountMinor BigInt        @map("amount_minor")
  expense     ExpenseRecord @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id])

  @@id([expenseId, userId])
  @@index([userId])
  @@map("shared_expense_payers")
}

model SharedExpenseAllocation {
  expenseId   String        @map("expense_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  amountMinor BigInt        @map("amount_minor")
  expense     ExpenseRecord @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id])

  @@id([expenseId, userId])
  @@index([userId])
  @@map("shared_expense_allocations")
}

model ExpenseMutationReceipt {
  id          String                @id @default(uuid()) @db.Uuid
  spaceId     String                @map("space_id") @db.Uuid
  actorUserId String                @map("actor_user_id") @db.Uuid
  requestId   String                @map("request_id") @db.Uuid
  action      ExpenseMutationAction
  payloadHash String                @map("payload_hash") @db.VarChar(64)
  response    Json
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  space       FinancialSpace        @relation(fields: [spaceId], references: [id])
  actor       User                  @relation("ExpenseReceiptActor", fields: [actorUserId], references: [id])

  @@unique([spaceId, actorUserId, requestId])
  @@map("expense_mutation_receipts")
}

enum PersonalReferenceStatus {
  ACTIVE
  REMOVED
}

enum PersonalReferenceAction {
  CREATE
  UPDATE
  REMOVE
}

model PersonalExpenseReference {
  id              String                        @id @default(uuid()) @db.Uuid
  personalSpaceId String                        @map("personal_space_id") @db.Uuid
  sourceExpenseId String                        @map("source_expense_id") @db.Uuid
  ownerUserId     String                        @map("owner_user_id") @db.Uuid
  privateNote     String?                       @map("private_note") @db.VarChar(2000)
  status          PersonalReferenceStatus       @default(ACTIVE)
  version         Int                           @default(1)
  createdAt       DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(6)
  personalSpace   FinancialSpace                @relation("PersonalReferenceSpace", fields: [personalSpaceId], references: [id], onDelete: Restrict)
  sourceExpense   ExpenseRecord                 @relation(fields: [sourceExpenseId], references: [id], onDelete: Restrict)
  owner           User                          @relation("PersonalReferenceOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  tags            PersonalExpenseReferenceTag[]

  @@unique([personalSpaceId, sourceExpenseId, ownerUserId])
  @@index([personalSpaceId, status])
  @@index([sourceExpenseId, status])
  @@index([ownerUserId, status])
  @@map("personal_expense_references")
}

model PersonalExpenseReferenceTag {
  referenceId String                   @map("reference_id") @db.Uuid
  tagId       String                   @map("tag_id") @db.Uuid
  reference   PersonalExpenseReference @relation(fields: [referenceId], references: [id], onDelete: Cascade)
  tag         TaxonomyTerm             @relation(fields: [tagId], references: [id], onDelete: Restrict)

  @@id([referenceId, tagId])
  @@map("personal_expense_reference_tags")
}

model PersonalReferenceReceipt {
  id          String                  @id @default(uuid()) @db.Uuid
  spaceId     String                  @map("space_id") @db.Uuid
  actorUserId String                  @map("actor_user_id") @db.Uuid
  requestId   String                  @map("request_id") @db.Uuid
  action      PersonalReferenceAction
  payloadHash String                  @map("payload_hash") @db.VarChar(64)
  response    Json
  createdAt   DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  space       FinancialSpace          @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  actor       User                    @relation("PersonalReferenceReceiptActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([spaceId, actorUserId, requestId])
  @@map("personal_reference_receipts")
}

enum SharedBatchStatus {
  PENDING
  COMPLETED
  CANCELED
}

enum SharedTransferStatus {
  AWAITING_PAYMENT
  SENT
  COMPLETED
}

enum SharedOperationAction {
  BATCH_START
  BATCH_CANCEL
  TRANSFER_SENT
  TRANSFER_RECEIVED
  EXPENSE_CORRECTION
  TRANSFER_CORRECTION
}

model SharedSettlementBatch {
  id            String                     @id @default(uuid()) @db.Uuid
  spaceId       String                     @map("space_id") @db.Uuid
  periodStart   DateTime                   @map("period_start") @db.Date
  periodEnd     DateTime                   @map("period_end") @db.Date
  status        SharedBatchStatus          @default(PENDING)
  version       Int                        @default(1)
  snapshot      Json
  createdById   String                     @map("created_by_id") @db.Uuid
  createdAt     DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  completedById String?                    @map("completed_by_id") @db.Uuid
  completedAt   DateTime?                  @map("completed_at") @db.Timestamptz(6)
  canceledById  String?                    @map("canceled_by_id") @db.Uuid
  canceledAt    DateTime?                  @map("canceled_at") @db.Timestamptz(6)
  space         FinancialSpace             @relation(fields: [spaceId], references: [id])
  creator       User                       @relation("SharedBatchCreator", fields: [createdById], references: [id])
  completer     User?                      @relation("SharedBatchCompleter", fields: [completedById], references: [id], onDelete: Restrict)
  canceler      User?                      @relation("SharedBatchCanceler", fields: [canceledById], references: [id], onDelete: Restrict)
  transfers     SharedSettlementTransfer[]

  @@index([spaceId, periodEnd])
  @@map("shared_settlement_batches")
}

model SharedSettlementTransfer {
  id           String                @id @default(uuid()) @db.Uuid
  batchId      String                @map("batch_id") @db.Uuid
  fromUserId   String                @map("from_user_id") @db.Uuid
  toUserId     String                @map("to_user_id") @db.Uuid
  amountMinor  Decimal               @map("amount_minor") @db.Decimal(65, 0)
  status       SharedTransferStatus  @default(AWAITING_PAYMENT)
  version      Int                   @default(1)
  sentById     String?               @map("sent_by_id") @db.Uuid
  sentAt       DateTime?             @map("sent_at") @db.Timestamptz(6)
  receivedById String?               @map("received_by_id") @db.Uuid
  receivedAt   DateTime?             @map("received_at") @db.Timestamptz(6)
  batch        SharedSettlementBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  fromUser     User                  @relation("SharedTransferFrom", fields: [fromUserId], references: [id])
  toUser       User                  @relation("SharedTransferTo", fields: [toUserId], references: [id])
  sender       User?                 @relation("SharedTransferSender", fields: [sentById], references: [id], onDelete: Restrict)
  receiver     User?                 @relation("SharedTransferReceiver", fields: [receivedById], references: [id], onDelete: Restrict)
  corrections  SharedCorrection[]

  @@index([batchId, status])
  @@map("shared_settlement_transfers")
}

model SharedCorrection {
  id                String                       @id @default(uuid()) @db.Uuid
  spaceId           String                       @map("space_id") @db.Uuid
  sourceExpenseId   String?                      @map("source_expense_id") @db.Uuid
  sourceTransferId  String?                      @map("source_transfer_id") @db.Uuid
  revision          Int
  occurredOn        DateTime                     @map("occurred_on") @db.Date
  reason            String                       @db.VarChar(2000)
  amountMinor       Decimal                      @map("amount_minor") @db.Decimal(65, 0)
  targetAmountMinor Decimal                      @map("target_amount_minor") @db.Decimal(65, 0)
  createdById       String                       @map("created_by_id") @db.Uuid
  createdAt         DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  space             FinancialSpace               @relation(fields: [spaceId], references: [id])
  sourceExpense     ExpenseRecord?               @relation(fields: [sourceExpenseId], references: [id], onDelete: Restrict)
  sourceTransfer    SharedSettlementTransfer?    @relation(fields: [sourceTransferId], references: [id], onDelete: Restrict)
  creator           User                         @relation("SharedCorrectionCreator", fields: [createdById], references: [id])
  payers            SharedCorrectionPayer[]
  allocations       SharedCorrectionAllocation[]

  @@unique([sourceExpenseId, revision])
  @@unique([sourceTransferId, revision])
  @@index([spaceId, occurredOn, id])
  @@map("shared_corrections")
}

model SharedCorrectionPayer {
  correctionId String           @map("correction_id") @db.Uuid
  userId       String           @map("user_id") @db.Uuid
  amountMinor  Decimal          @map("amount_minor") @db.Decimal(65, 0)
  correction   SharedCorrection @relation(fields: [correctionId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id])

  @@id([correctionId, userId])
  @@map("shared_correction_payers")
}

model SharedCorrectionAllocation {
  correctionId String           @map("correction_id") @db.Uuid
  userId       String           @map("user_id") @db.Uuid
  amountMinor  Decimal          @map("amount_minor") @db.Decimal(65, 0)
  correction   SharedCorrection @relation(fields: [correctionId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id])

  @@id([correctionId, userId])
  @@map("shared_correction_allocations")
}

model SharedOperationReceipt {
  id          String                @id @default(uuid()) @db.Uuid
  spaceId     String                @map("space_id") @db.Uuid
  actorUserId String                @map("actor_user_id") @db.Uuid
  requestId   String                @map("request_id") @db.Uuid
  action      SharedOperationAction
  payloadHash String                @map("payload_hash") @db.VarChar(64)
  response    Json
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  space       FinancialSpace        @relation(fields: [spaceId], references: [id])
  actor       User                  @relation(fields: [actorUserId], references: [id])

  @@unique([spaceId, actorUserId, requestId])
  @@map("shared_operation_receipts")
}

enum PooledCadence {
  WEEKLY
  MONTHLY
}

enum PooledCommitmentStatus {
  ACTIVE
  CANCELED
}

enum PooledOccurrenceStatus {
  EXPECTED
  CONFIRMED
  SKIPPED
  CANCELED
}

enum PooledPaymentSource {
  FUND_PAID
  PARTICIPANT_ADVANCED
}

enum PooledWorkflowStatus {
  AWAITING_PAYMENT
  SENT
  COMPLETED
}

enum PooledCorrectionSourceKind {
  EXPENSE
  REIMBURSEMENT
  RETURN
  CONTRIBUTION
}

enum PooledReturnPlanStatus {
  ACTIVE
  COMPLETED
}

enum PooledPostingEntityType {
  CONTRIBUTION
  REIMBURSEMENT
  RETURN
}

enum PooledPostingTransition {
  CONFIRMED
  SENT
  RECEIVED
}

enum PooledOperationAction {
  COMMITMENT_CREATE
  COMMITMENT_UPDATE
  OCCURRENCE_CONFIRM
  OCCURRENCE_SKIP
  OCCURRENCE_CANCEL
  EXPENSE_CREATE
  EXPENSE_UPDATE
  EXPENSE_DELETE
  REIMBURSEMENT_SENT
  REIMBURSEMENT_RECEIVED
  CORRECTION_CREATE
  CLOSING_START
  RETURN_PLAN_CREATE
  RETURN_SENT
  RETURN_RECEIVED
  ARCHIVE
}

model PooledCommitment {
  id               String                         @id @default(uuid()) @db.Uuid
  spaceId          String                         @map("space_id") @db.Uuid
  name             String                         @db.VarChar(100)
  cadence          PooledCadence
  interval         Int                            @default(1)
  startsOn         DateTime                       @map("starts_on") @db.Date
  endsOn           DateTime?                      @map("ends_on") @db.Date
  generatedThrough DateTime                       @map("generated_through") @db.Date
  status           PooledCommitmentStatus         @default(ACTIVE)
  version          Int                            @default(1)
  createdById      String                         @map("created_by_id") @db.Uuid
  createdAt        DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(6)
  space            FinancialSpace                 @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  creator          User                           @relation("PooledCommitmentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignments      PooledCommitmentAssignment[]
  occurrences      PooledContributionOccurrence[]

  @@index([spaceId, status])
  @@map("pooled_commitments")
}

model PooledCommitmentAssignment {
  commitmentId      String           @map("commitment_id") @db.Uuid
  participantUserId String           @map("participant_user_id") @db.Uuid
  amountMinor       Decimal          @map("amount_minor") @db.Decimal(65, 0)
  commitment        PooledCommitment @relation(fields: [commitmentId], references: [id], onDelete: Cascade)
  participant       User             @relation(fields: [participantUserId], references: [id], onDelete: Restrict)

  @@id([commitmentId, participantUserId])
  @@map("pooled_commitment_assignments")
}

model PooledContributionOccurrence {
  id                String                 @id @default(uuid()) @db.Uuid
  commitmentId      String                 @map("commitment_id") @db.Uuid
  participantUserId String                 @map("participant_user_id") @db.Uuid
  dueOn             DateTime               @map("due_on") @db.Date
  amountMinor       Decimal                @map("amount_minor") @db.Decimal(65, 0)
  status            PooledOccurrenceStatus @default(EXPECTED)
  version           Int                    @default(1)
  confirmedById     String?                @map("confirmed_by_id") @db.Uuid
  confirmedAt       DateTime?              @map("confirmed_at") @db.Timestamptz(6)
  skippedById       String?                @map("skipped_by_id") @db.Uuid
  skippedAt         DateTime?              @map("skipped_at") @db.Timestamptz(6)
  canceledById      String?                @map("canceled_by_id") @db.Uuid
  canceledAt        DateTime?              @map("canceled_at") @db.Timestamptz(6)
  commitment        PooledCommitment       @relation(fields: [commitmentId], references: [id], onDelete: Restrict)
  participant       User                   @relation("PooledOccurrenceParticipant", fields: [participantUserId], references: [id], onDelete: Restrict)
  confirmer         User?                  @relation("PooledOccurrenceConfirmer", fields: [confirmedById], references: [id], onDelete: Restrict)
  skipper           User?                  @relation("PooledOccurrenceSkipper", fields: [skippedById], references: [id], onDelete: Restrict)
  canceler          User?                  @relation("PooledOccurrenceCanceler", fields: [canceledById], references: [id], onDelete: Restrict)
  contribution      PooledContribution?

  @@unique([commitmentId, participantUserId, dueOn])
  @@index([participantUserId, status, dueOn])
  @@map("pooled_contribution_occurrences")
}

model PooledContribution {
  id                String                       @id @default(uuid()) @db.Uuid
  spaceId           String                       @map("space_id") @db.Uuid
  occurrenceId      String                       @unique @map("occurrence_id") @db.Uuid
  participantUserId String                       @map("participant_user_id") @db.Uuid
  amountMinor       Decimal                      @map("amount_minor") @db.Decimal(65, 0)
  confirmedById     String                       @map("confirmed_by_id") @db.Uuid
  confirmedAt       DateTime                     @map("confirmed_at") @db.Timestamptz(6)
  space             FinancialSpace               @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  occurrence        PooledContributionOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Restrict)
  participant       User                         @relation("PooledContributionParticipant", fields: [participantUserId], references: [id], onDelete: Restrict)
  confirmer         User                         @relation("PooledContributionConfirmer", fields: [confirmedById], references: [id], onDelete: Restrict)

  @@index([spaceId, confirmedAt])
  @@map("pooled_contributions")
}

model PooledExpensePayment {
  expenseId     String               @id @map("expense_id") @db.Uuid
  source        PooledPaymentSource
  advancedById  String?              @map("advanced_by_id") @db.Uuid
  expense       ExpenseRecord        @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  advancer      User?                @relation("PooledExpenseAdvancer", fields: [advancedById], references: [id], onDelete: Restrict)
  reimbursement PooledReimbursement?

  @@index([advancedById])
  @@map("pooled_expense_payments")
}

model PooledReimbursement {
  id                String               @id @default(uuid()) @db.Uuid
  spaceId           String               @map("space_id") @db.Uuid
  expenseId         String               @unique @map("expense_id") @db.Uuid
  participantUserId String               @map("participant_user_id") @db.Uuid
  amountMinor       Decimal              @map("amount_minor") @db.Decimal(65, 0)
  status            PooledWorkflowStatus @default(AWAITING_PAYMENT)
  version           Int                  @default(1)
  sentById          String?              @map("sent_by_id") @db.Uuid
  sentAt            DateTime?            @map("sent_at") @db.Timestamptz(6)
  receivedById      String?              @map("received_by_id") @db.Uuid
  receivedAt        DateTime?            @map("received_at") @db.Timestamptz(6)
  space             FinancialSpace       @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  payment           PooledExpensePayment @relation(fields: [expenseId], references: [expenseId], onDelete: Restrict)
  participant       User                 @relation("PooledReimbursementParticipant", fields: [participantUserId], references: [id], onDelete: Restrict)
  sender            User?                @relation("PooledReimbursementSender", fields: [sentById], references: [id], onDelete: Restrict)
  receiver          User?                @relation("PooledReimbursementReceiver", fields: [receivedById], references: [id], onDelete: Restrict)

  @@index([spaceId, status])
  @@map("pooled_reimbursements")
}

model PooledCorrection {
  id          String                     @id @default(uuid()) @db.Uuid
  spaceId     String                     @map("space_id") @db.Uuid
  sourceKind  PooledCorrectionSourceKind @map("source_kind")
  sourceId    String                     @map("source_id") @db.Uuid
  amountMinor Decimal                    @map("amount_minor") @db.Decimal(65, 0)
  occurredOn  DateTime                   @map("occurred_on") @db.Date
  reason      String                     @db.VarChar(2000)
  createdById String                     @map("created_by_id") @db.Uuid
  createdAt   DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  space       FinancialSpace             @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  creator     User                       @relation("PooledCorrectionCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([spaceId, occurredOn, id])
  @@map("pooled_corrections")
}

model PooledReturnPlan {
  id          String                 @id @default(uuid()) @db.Uuid
  spaceId     String                 @map("space_id") @db.Uuid
  status      PooledReturnPlanStatus @default(ACTIVE)
  version     Int                    @default(1)
  createdById String                 @map("created_by_id") @db.Uuid
  createdAt   DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  space       FinancialSpace         @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  creator     User                   @relation("PooledReturnPlanCreator", fields: [createdById], references: [id], onDelete: Restrict)
  returns     PooledReturn[]

  @@index([spaceId, status])
  @@map("pooled_return_plans")
}

model PooledReturn {
  id              String               @id @default(uuid()) @db.Uuid
  planId          String               @map("plan_id") @db.Uuid
  recipientUserId String               @map("recipient_user_id") @db.Uuid
  amountMinor     Decimal              @map("amount_minor") @db.Decimal(65, 0)
  status          PooledWorkflowStatus @default(AWAITING_PAYMENT)
  version         Int                  @default(1)
  sentById        String?              @map("sent_by_id") @db.Uuid
  sentAt          DateTime?            @map("sent_at") @db.Timestamptz(6)
  receivedById    String?              @map("received_by_id") @db.Uuid
  receivedAt      DateTime?            @map("received_at") @db.Timestamptz(6)
  plan            PooledReturnPlan     @relation(fields: [planId], references: [id], onDelete: Restrict)
  recipient       User                 @relation("PooledReturnRecipient", fields: [recipientUserId], references: [id], onDelete: Restrict)
  sender          User?                @relation("PooledReturnSender", fields: [sentById], references: [id], onDelete: Restrict)
  receiver        User?                @relation("PooledReturnReceiver", fields: [receivedById], references: [id], onDelete: Restrict)

  @@unique([planId, recipientUserId])
  @@index([planId, status])
  @@map("pooled_returns")
}

model PooledTransitionPosting {
  id          String                  @id @default(uuid()) @db.Uuid
  spaceId     String                  @map("space_id") @db.Uuid
  entityType  PooledPostingEntityType @map("entity_type")
  entityId    String                  @map("entity_id") @db.Uuid
  transition  PooledPostingTransition
  amountMinor Decimal                 @map("amount_minor") @db.Decimal(65, 0)
  actorUserId String                  @map("actor_user_id") @db.Uuid
  postedAt    DateTime                @map("posted_at") @db.Timestamptz(6)
  space       FinancialSpace          @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  actor       User                    @relation("PooledPostingActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([entityType, entityId, transition])
  @@index([spaceId, postedAt])
  @@map("pooled_transition_postings")
}

model PooledOperationReceipt {
  id          String                @id @default(uuid()) @db.Uuid
  spaceId     String                @map("space_id") @db.Uuid
  actorUserId String                @map("actor_user_id") @db.Uuid
  requestId   String                @map("request_id") @db.Uuid
  action      PooledOperationAction
  payloadHash String                @map("payload_hash") @db.VarChar(64)
  response    Json
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  space       FinancialSpace        @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  actor       User                  @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([spaceId, actorUserId, requestId])
  @@map("pooled_operation_receipts")
}
