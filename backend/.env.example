DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mimic?schema=public"
JWT_ACCESS_SECRET="mimic-local-access-secret"
JWT_REFRESH_SECRET="mimic-local-refresh-secret"
PORT=3000
CORS_ORIGIN="http://localhost:8080"

# Optional developer-only Sentry error diagnostics. Leave the DSN blank to disable.
MIMIC_SENTRY_DSN=""
MIMIC_ENVIRONMENT="development"
MIMIC_BACKEND_REVISION=""
# Optional safe trace rate in the inclusive range 0..1; invalid values disable tracing.
MIMIC_SENTRY_TRACES_SAMPLE_RATE="0"
