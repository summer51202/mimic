    "**/test/taxonomy.e2e-spec.ts",
    "**/test/shared-expenses.e2e-spec.ts",
    "**/test/shared-expenses-concurrency.e2e-spec.ts",
    "**/test/shared-settlements.e2e-spec.ts",
    "**/test/shared-corrections.e2e-spec.ts",
    "**/test/shared-settlements-concurrency.e2e-spec.ts",
    "**/test/shared-lifecycle.e2e-spec.ts",
    "**/test/shared-lifecycle-concurrency.e2e-spec.ts",
