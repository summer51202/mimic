MIMIC_API_BASE_URL=http://localhost:3000/api/v1
MIMIC_COOKIE_SECURE=false

# Optional developer-only Sentry diagnostics. The public DSN is safe to expose;
# never expose the server DSN or SENTRY_AUTH_TOKEN through NEXT_PUBLIC variables.
NEXT_PUBLIC_MIMIC_SENTRY_DSN=""
NEXT_PUBLIC_MIMIC_ENVIRONMENT="development"
NEXT_PUBLIC_MIMIC_SENTRY_TRACES_SAMPLE_RATE="0"
MIMIC_SENTRY_DSN=""
MIMIC_ENVIRONMENT="development"
MIMIC_WEB_REVISION=""
MIMIC_SENTRY_TRACES_SAMPLE_RATE="0"
